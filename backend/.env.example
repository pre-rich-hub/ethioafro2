NODE_ENV=development
PORT=5000

# Neon PostgreSQL. DATABASE_URL carries runtime traffic and should be the
# -pooler endpoint. DIRECT_URL is Prisma's directUrl, used for migrations and
# seeds only.
#
# connect_timeout matters more than it looks. Neon suspends the compute after a
# few idle minutes, and the first query after a wake fails with "Can't reach
# database server" unless the driver waits the compute out. Measured here: a cold
# start took 3.1s and the default timeout lost the race.
DATABASE_URL="postgresql://user:password@host-pooler.example.com/neondb?sslmode=require&connect_timeout=30"
DIRECT_URL="postgresql://user:password@host.example.com/neondb?sslmode=require&connect_timeout=30"

# Frontend origin for CORS. Comma-separated for multiple origins.
FRONTEND_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=admin_session
COOKIE_SECURE=false

# Email (smtp or resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Simien Ethiopia Tours <info@example.com>"
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
ADMIN_EMAIL=info@example.com
ADMIN_PASSWORD=
EMAIL_ENABLED=false

# File uploads
UPLOAD_ROOT=.
PUBLIC_FILE_BASE_URL=
MAX_UPLOAD_MB=4

# Storage (local | database; database is inferred on Vercel)
STORAGE_DRIVER=local

# AI assistant
#
# Flip ASSISTANT_ENABLED to true only once the key for ASSISTANT_PROVIDER is set.
# The two are validated together at boot: enabled with an empty key throws and the
# function never constructs, so /health 500s too. Every key below ships empty on
# purpose, none of them are real.
ASSISTANT_ENABLED=false
# Provider: openai | gemini | groq
ASSISTANT_PROVIDER=groq
OPENAI_API_KEY=
GEMINI_API_KEY=
# Groq serves the OpenAI chat completions shape, so it reuses the same client
# with a different base URL. Groq is the fastest of the three and the cheapest
# for the open-weight models, which makes it the better default if you have not
# settled on a provider yet.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Must be a model the chosen provider actually serves. Groq production models:
# llama-3.3-70b-versatile, llama-3.1-8b-instant, openai/gpt-oss-120b,
# openai/gpt-oss-20b. List yours with GET $GROQ_BASE_URL/models.
ASSISTANT_MODEL=openai/gpt-oss-120b
# Secondary model used when the primary keeps failing transiently.
#
# This must carry a value. Leaving it blank is not the same as leaving it out: zod's
# .default() only fills an absent key, so an explicit empty string parses as "" and
# provider.client.ts then builds no fallback at all. That is a silent feature
# disable that no error names.
ASSISTANT_FALLBACK_MODEL=openai/gpt-oss-20b
# Attempts before giving up on a model, with exponential backoff between them.
ASSISTANT_MAX_ATTEMPTS=3
ASSISTANT_RETRY_BASE_MS=500
# Conversation caps
ASSISTANT_MAX_MESSAGES=30
ASSISTANT_MAX_SESSION_TOKENS=50000
ASSISTANT_MAX_OUTPUT_TOKENS=600
ASSISTANT_MAX_HISTORY_MESSAGES=10
ASSISTANT_MAX_CONTEXT_CHARS=40000
ASSISTANT_MAX_DAILY_TOKENS=200000
# Streaming
ASSISTANT_STREAM=true
# Must stay below the frontend abort (150s) so the server can send a clean
# error frame instead of leaving the client to time out mid-answer.
ASSISTANT_STREAM_TIMEOUT_MS=120000
# Context cache TTL (ms)
ASSISTANT_CONTEXT_TTL_MS=300000
# IP hashing salt for usage tracking (falls back to JWT_SECRET)
ASSISTANT_IP_HASH_SALT=
